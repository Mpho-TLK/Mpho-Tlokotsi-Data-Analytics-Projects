   "source": [
    "## 6. Sentiment Labelling\n",
    "\n",
    "The CFPB dataset has no built-in sentiment column, so we create one using a **domain-specific keyword approach**. We count negative vs positive financial-complaint keywords in each narrative and combine that with the company response / dispute flag as a tiebreaker.\n",
    "(Manning, Raghavan and Schütze, 2008)\n",
    "This is preferred over a generic sentiment tool because complaint language has its own vocabulary (e.g. \"denied\", \"fraud\", \"harassment\" are strongly negative in this context)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "58829e59",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Sentiment distribution:\n",
      "  Negative: 191 (57.4%)\n",
      "  Neutral: 101 (30.3%)\n",
      "  Positive: 41 (12.3%)\n"
     ]
    }
   ],
   "source": [
    "# Domain-specific keyword lists\n",
    "negative_words = {\n",
    "    \"fraud\", \"fraudulent\", \"harassment\", \"denied\", \"deny\", \"error\", \"violation\",\n",
    "    \"illegal\", \"scam\", \"stolen\", \"unauthorized\", \"unfair\", \"incorrect\", \"wrong\",\n",
    "    \"dispute\", \"fail\", \"failed\", \"failure\", \"ignore\", \"refused\", \"delay\", \"delayed\",\n",
    "    \"threaten\", \"victim\", \"damage\", \"negligence\", \"lawsuit\", \"terrible\", \"horrible\",\n",
    "    \"frustrated\", \"angry\", \"upset\", \"disappointed\", \"worst\"\n",
    "}\n",
    "positive_words = {\n",
    "    \"resolved\", \"satisfied\", \"corrected\", \"refunded\", \"helpful\", \"thank\",\n",
    "    \"appreciate\", \"great\", \"excellent\", \"good\", \"happy\", \"pleased\", \"professional\",\n",
    "    \"quick\", \"prompt\", \"fair\", \"solved\"\n",
    "}\n",
    "\n",
    "def assign_sentiment(row):\n",
    "    tokens = set(row[\"clean_narrative\"].split())\n",
    "    neg = len(tokens & negative_words)\n",
    "    pos = len(tokens & positive_words)\n",
    "\n",
    "    resolved_well = (\n",
    "        row.get(\"Company response to consumer\", \"\") in\n",
    "        [\"Closed with monetary relief\", \"Closed with non-monetary relief\"]\n",
    "        and row.get(\"Consumer disputed?\", \"No\") != \"Yes\"\n",
    "    )\n",
    "\n",
    "    if neg > pos:\n",
    "        return \"Negative\"\n",
    "    elif pos > neg:\n",
    "        return \"Positive\"\n",
    "    else:\n",
    "        if resolved_well:\n",
    "            return \"Positive\"\n",
    "        elif row.get(\"Consumer disputed?\", \"No\") == \"Yes\":\n",
    "            return \"Negative\"\n",
    "        else:\n",
    "            return \"Neutral\"\n",
    "\n",
    "text_df[\"sentiment\"] = text_df.apply(assign_sentiment, axis=1)\n",
    "\n",
    "counts = text_df[\"sentiment\"].value_counts()\n",
    "print(\"Sentiment distribution:\")\n",
    "for label, n in counts.items():\n",
    "    print(f\"  {label}: {n:,} ({n/len(text_df)*100:.1f}%)\")"
   ]
  },
