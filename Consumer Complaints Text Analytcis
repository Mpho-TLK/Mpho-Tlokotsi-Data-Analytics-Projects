    "\n",
    "import pandas as pd\n",
    "\n",
    "CSV_PATH = \"complaints.csv\"\n",
    "TARGET_N = 30000\n",
    "\n",
    "chunks = []\n",
    "rows_read = 0\n",
    "for chunk in pd.read_csv(CSV_PATH, chunksize=50000, low_memory=False):\n",
    "    chunks.append(chunk)\n",
    "    rows_read += len(chunk)\n",
    "    if rows_read >= TARGET_N * 3:\n",
    "        break\n",
    "\n",
    "full_df = pd.concat(chunks, ignore_index=True)\n",
    "df = full_df.sample(n=min(TARGET_N, len(full_df)), random_state=RANDOM_STATE).reset_index(drop=True)\n",
    "print(f\"Loaded {len(df):,} records from {CSV_PATH}.\")\n",
    "\n",
    "# Standardise column names to match the CSV export format\n",
    "rename_map = {\n",
    "    \"date_received\": \"Date received\", \"product\": \"Product\",\n",
    "    \"complaint_what_happened\": \"Consumer complaint narrative\",\n",
    "    \"company_response\": \"Company response to consumer\",\n",
    "    \"consumer_disputed\": \"Consumer disputed?\", \"complaint_id\": \"Complaint ID\",\n",
    "    \"submitted_via\": \"Submitted via\", \"state\": \"State\", \"timely\": \"Timely response?\"\n",
    "}\n",
    "df = df.rename(columns=rename_map)\n",
    "keep = [c for c in rename_map.values() if c in df.columns]\n",
    "df = df[keep].copy()\n",
    "print(f\"Final shape: {df.shape}\")\n",
    "df.head(3)"
