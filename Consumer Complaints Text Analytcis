    "## 5. Preprocessing\n",
    "\n",
    "Steps applied to each narrative:\n",
    "1. Lowercase\n",
    "2. Remove URLs, HTML tags, and CFPB redaction placeholders (XXXX)\n",
    "3. Remove punctuation and digits\n",
    "4. Remove stopwords — but **keep negation words** (not, no, never) to preserve meaning (e.g. \"not happy\" must not become \"happy\")\n",
    "5. Lemmatise (e.g. \"complained\" → \"complain\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "5a1f9070",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Records after cleaning: 333\n"
     ]
    }
   ],
   "source": [
    "# Set up stopwords and lemmatizer\n",
    "stop_words = set(stopwords.words(\"english\"))\n",
    "\n",
    "# Keep negation words so we don't flip sentiment meaning\n",
    "negation = {\"not\", \"no\", \"nor\", \"never\", \"cannot\", \"without\"}\n",
    "stop_words = stop_words - negation\n",
    "\n",
    "# Add CFPB-specific noise\n",
    "stop_words = stop_words | {\"xxxx\", \"xx\", \"would\", \"could\", \"also\"}\n",
    "\n",
    "lemmatizer = WordNetLemmatizer()\n",
    "\n",
    "def clean_text(text):\n",
    "    text = str(text).lower()\n",
    "    text = re.sub(r\"http\\S+|www\\S+\", \" \", text)   # URLs\n",
    "    text = re.sub(r\"<.*?>\", \" \", text)               # HTML\n",
    "    text = re.sub(r\"x{2,}\", \" \", text)               # XXXX placeholders\n",
    "    text = re.sub(r\"[^a-z\\s]\", \" \", text)           # punctuation & digits\n",
    "    text = re.sub(r\"\\s+\", \" \", text).strip()\n",
    "    tokens = [lemmatizer.lemmatize(w) for w in text.split()\n",
    "              if w not in stop_words and len(w) > 2]\n",
    "    return \" \".join(tokens)\n",
    "\n",
    "text_df[\"clean_narrative\"] = text_df[\"Consumer complaint narrative\"].apply(clean_text)\n",
    "text_df = text_df[text_df[\"clean_narrative\"].str.len() > 0].reset_index(drop=True)\n",
    "print(f\"Records after cleaning: {len(text_df):,}\")"
   ]
